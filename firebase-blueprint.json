{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User preferences and settings.",
      "type": "object",
      "properties": {
        "persona": { "type": "string", "enum": ["Supportive Peer", "Direct Coach", "Formal Mentor"] },
        "length": { "type": "string", "enum": ["Ultra-short (<50 words)", "Detailed (<150 words)"] },
        "microStepType": { "type": "string", "enum": ["Physical", "Digital", "Mental"] },
        "email": { "type": "string", "format": "email" }
      },
      "required": ["persona", "length", "microStepType", "email"]
    },
    "Session": {
      "title": "Interception Session",
      "description": "A record of an AI speedbump event.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "emotion": { "type": "string" },
        "task": { "type": "string" },
        "aiResponse": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "completed": { "type": "boolean" }
      },
      "required": ["userId", "emotion", "task", "aiResponse", "timestamp", "completed"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user preferences."
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "Session",
      "description": "User's session history."
    }
  }
}
